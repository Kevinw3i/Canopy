# Control-plane configuration
DEV_MODE=1
CONFIG_PATH=config.toml
RUST_LOG=control_plane=debug,tower_http=debug

# Override: allow dev_mode on non-loopback bind address (unsafe)
# ALLOW_DEV_MODE_REMOTE=1

# AWS (the control-plane uses ambient credentials for the base STS caller)
# AWS_REGION=us-east-1
# AWS_PROFILE=canopy-base

# NOTE: OIDC, JWT, and other application settings are configured in config.toml,
# NOT via environment variables. See config.sample.toml for the full reference.
