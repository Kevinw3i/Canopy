aws_region         = "ap-northeast-1"
# Project is used in ALB, target group, ECR, ECS, IAM, and log names.
# project            = "canopy"

# Networking:
# Option A: use existing VPC/subnets.
create_vpc         = false
vpc_id             = "vpc-xxxxxxxxxxxxxxxxx"
public_subnet_ids  = ["subnet-aaa", "subnet-bbb"]
private_subnet_ids = ["subnet-ccc", "subnet-ddd"]

# Option B: create a dedicated VPC. Set create_vpc = true and tune CIDRs.
# create_vpc           = true
# vpc_cidr             = "10.200.0.0/16"
# public_subnet_cidrs  = ["10.200.0.0/24", "10.200.1.0/24"]
# private_subnet_cidrs = ["10.200.10.0/24", "10.200.11.0/24"]
# single_nat_gateway   = true

acm_certificate_arn = "arn:aws:acm:ap-northeast-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Image tag (required — use a versioned tag or git SHA, not "latest")
image_tag = "v0.1.0"

# Fargate Linux task size. Defaults are 512 CPU units and 1024 MiB memory.
# cpu    = 512
# memory = 1024

# JWT secret — create out-of-band, pass ARN here (never stored in Terraform state)
# aws secretsmanager create-secret --name canopy/jwt-secret --secret-string "$(openssl rand -base64 44)"
# aws secretsmanager list-secret-version-ids --secret-id canopy/jwt-secret --query 'Versions[?VersionStages[0]==`AWSCURRENT`].VersionId | [0]' --output text
jwt_secret_arn        = "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:canopy/jwt-secret-XXXXXX"
jwt_secret_version_id = "00000000-0000-0000-0000-000000000000"

# ALB defaults to internal. Provide at least one CIDR (e.g. your VPC CIDR for internal).
alb_allowed_cidrs = ["10.0.0.0/16"]
# alb_internal    = false  # set to false + office CIDRs for public access

# Optional: Route 53 DNS record
# Set both values to create the record; leave both commented to skip DNS.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"
# domain_name     = "canopy.example.com"

oidc_issuer_url = "https://accounts.google.com"
oidc_client_id  = "your-client-id"

# Runtime defaults generated into config.toml by the ECS entrypoint.
# jwt_expiry_seconds            = 3600
# aws_session_duration_seconds  = 3600
# log_retention_days            = 90

# STS ExternalId for cross-account AssumeRole (must match target trust policy)
# sts_external_id = "my-custom-external-id"

# Cross-account roles the control-plane can assume
# assumable_role_arns = [
#   "arn:aws:iam::111111111111:role/CanopyRole",
#   "arn:aws:iam::222222222222:role/CanopyRole",
# ]
