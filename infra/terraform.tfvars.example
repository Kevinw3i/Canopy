aws_region         = "ap-northeast-1"
# Project is used in ALB, target group, ECR, ECS, IAM, and log names.
# project            = "canopy"

# Networking:
# Option A: use existing VPC/subnets.
create_vpc         = false
vpc_id             = "vpc-00000000000000000"
public_subnet_ids  = ["subnet-00000000000000001", "subnet-00000000000000002"]
private_subnet_ids = ["subnet-00000000000000003", "subnet-00000000000000004"]

# Option B: create a dedicated VPC. Set create_vpc = true and tune CIDRs.
# create_vpc           = true
# vpc_cidr             = "10.200.0.0/16"
# public_subnet_cidrs  = ["10.200.0.0/24", "10.200.1.0/24"]
# private_subnet_cidrs = ["10.200.10.0/24", "10.200.11.0/24"]
# Set false for one NAT per private subnet/AZ; requires at least as many public CIDRs as private CIDRs.
# single_nat_gateway   = true

acm_certificate_arn = "arn:aws:acm:ap-northeast-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Image tag (required — use a versioned tag or git SHA, not "latest")
image_tag = "v0.1.0"

# Fargate Linux task size. Defaults are 512 CPU units and 1024 MiB memory.
# cpu    = 512
# memory = 1024

# JWT secret — create out-of-band, pass ARN here (never stored in Terraform state)
# AWS_REGION=${AWS_REGION:-ap-northeast-1}
# aws secretsmanager create-secret \
#   --name canopy/jwt-secret \
#   --secret-string "$(openssl rand -base64 44)" \
#   --region "$AWS_REGION"
# aws secretsmanager list-secret-version-ids \
#   --secret-id canopy/jwt-secret \
#   --query 'Versions[?contains(VersionStages, `AWSCURRENT`)].VersionId | [0]' \
#   --output text \
#   --region "$AWS_REGION"
jwt_secret_arn        = "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:canopy/jwt-secret-XXXXXX"
jwt_secret_version_id = "00000000-0000-0000-0000-000000000000"

# Optional MCP database credentials. Create these secrets out-of-band; Terraform
# stores only the secret ARNs and non-secret connection metadata.
# SecretString shape:
#   {"username":"canopy_readonly","password":"..."}
# database_secret_arns = [
#   "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:canopy/db/orders-prod-XXXXXX",
# ]
#
# database_connections_toml = <<-TOML
# [database_connections.orders_prod]
# engine = "mysql"
# host = "orders-prod.xxxxxx.ap-northeast-1.rds.amazonaws.com"
# port = 3306
# database = "orders"
# secret_arn = "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:canopy/db/orders-prod-XXXXXX"
# readonly = true
# connect_timeout_ms = 3000
# statement_timeout_ms = 5000
# explain_timeout_ms = 3000
# max_connections = 4
# TOML

# ALB defaults to internal. Provide at least one CIDR (e.g. your VPC CIDR for internal).
alb_allowed_cidrs = ["10.0.0.0/16"]
# alb_internal    = false  # set to false + office/VPN CIDRs for public access
# allow_public_alb_world_cidr = true  # explicit opt-in only if public ALB must allow the whole internet

# Optional: Route 53 DNS record
# Set both values to create the record; leave both commented to skip DNS.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"
# domain_name     = "canopy.example.com"

oidc_issuer_url = "https://accounts.google.com"
oidc_client_id  = "your-client-id"

# Runtime defaults generated into config.toml by the ECS entrypoint.
# jwt_expiry_seconds            = 3600
# aws_session_duration_seconds  = 3600
# log_retention_days            = 90
# MCP session state. Keep dynamodb when desired_count > 1.
# mcp_session_store             = "dynamodb"
# mcp_session_table_name        = "canopy-mcp-sessions"
# MCP EC2 diagnostics dispatch. Leave empty/commented until the SSM document,
# helper, command store, and command-spec key secret are deployed together.
# mcp_ec2_diagnostic_ssm_document_name = "Canopy-Ec2Diagnostics"
# mcp_ec2_diagnostic_ssm_document_version = "7"
# mcp_ec2_diagnostic_helper_version = "2026-06-04.1"
# mcp_ec2_diagnostic_command_spec_key_secret_id = "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:canopy/mcp-ec2-command-spec-key-XXXXXX"
# mcp_ec2_diagnostic_command_spec_key_secret_version_id = "00000000-0000-0000-0000-000000000000"

# STS ExternalId for cross-account AssumeRole (must match target trust policy)
# sts_external_id = "my-custom-external-id"

# Cross-account roles the control-plane can assume. These sanitized examples
# match entitlements.catalog.sample.toml so the sample catalog validation
# workflow can run end to end.
assumable_role_arns = [
  "arn:aws:iam::123456789012:role/CanopyReadOnlyRole",
  "arn:aws:iam::123456789012:role/CanopyOperatorRole",
  "arn:aws:iam::234567890123:role/CanopyReadOnlyRole",
]
#
# Optional: allow AWS Organizations account discovery for same-named roles.
# Use with entitlements account_id = "*" and role_arn containing {account_id}.
# assumable_role_arn_patterns = [
#   "arn:aws:iam::*:role/CanopyRole",
# ]
